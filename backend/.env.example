# ===============================================
# Azure Document Intelligence Configuration
# ===============================================
AZURE_DOC_INTEL_ENDPOINT=https://your-doc-intel-resource.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=your_document_intelligence_key_here

# ===============================================
# Azure OpenAI Configuration
# ===============================================
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ===============================================
# Application Settings
# ===============================================
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true to test with sample pharma files if Azure keys are not yet provided
ENABLE_MOCK_FALLBACK=true
